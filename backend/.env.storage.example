# ========================================
# Storage Configuration Examples
# ========================================
# Choose one storage provider and configure accordingly

# ========================================
# Option 1: Local Storage (Development)
# ========================================
# Use local filesystem for file storage
# Pros: Fast, no setup needed
# Cons: Limited by disk space, no backup

STORAGE_PROVIDER=local
STORAGE_BASE_DIR=uploads


# ========================================
# Option 2: Google Drive (Production - Recommended)
# ========================================
# Use Google Drive for file storage
# Pros: 30GB free, automatic backup, scalable
# Cons: Requires Google Cloud setup

# STORAGE_PROVIDER=gdrive

# Service Account JSON Key File
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
# GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/service-account-key.json

# Root Folder ID in Google Drive
# Get from folder URL: https://drive.google.com/drive/folders/{FOLDER_ID}
# GDRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id


# ========================================
# Option 3: Backblaze B2 (Production - Lowest Cost)
# ========================================
# S3-compatible object storage
# Pros: ~3x cheaper storage than GCS ($0.006/GB vs $0.020/GB), 10GB + 1GB/day download free
# Cons: Requires Backblaze account setup

# STORAGE_PROVIDER=b2

# Bucket name (create in Backblaze B2 console)
# B2_BUCKET_NAME=mj-estimate-storage

# Application Key ID and Key (create in B2 console > App Keys)
# B2_KEY_ID=your_b2_key_id
# B2_APPLICATION_KEY=your_b2_application_key

# S3-compatible endpoint (shown in B2 bucket details, region-specific)
# Example: https://s3.us-west-004.backblazeb2.com
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Make uploaded files publicly accessible (default: false)
# B2_MAKE_PUBLIC=false


# ========================================
# Option 4: AWS S3 (Future)
# ========================================
# Use AWS S3 for file storage
# Not yet implemented

# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=mj-estimate
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key


# ========================================
# Option 5: Azure Blob Storage (Future)
# ========================================
# Use Azure Blob Storage for file storage
# Not yet implemented

# STORAGE_PROVIDER=azure
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string
# AZURE_CONTAINER_NAME=mj-estimate


# ========================================
# Setup Instructions
# ========================================
#
# 1. Local Storage (Immediate use):
#    - Set STORAGE_PROVIDER=local
#    - Set STORAGE_BASE_DIR=uploads
#    - No additional setup required
#
# 2. Google Drive (5 minutes setup):
#    a. Follow guide: backend/docs/GOOGLE_CLOUD_SETUP.md
#    b. Download service account JSON key
#    c. Create root folder in Google Drive
#    d. Share folder with service account email
#    e. Set STORAGE_PROVIDER=gdrive
#    f. Set GDRIVE_SERVICE_ACCOUNT_FILE path
#    g. Set GDRIVE_ROOT_FOLDER_ID
#
# 3. Backblaze B2 (5 minutes setup):
#    a. Create account at backblaze.com
#    b. Create a bucket (Buckets > Create a Bucket)
#    c. Create an Application Key (App Keys > Add a New Application Key)
#    d. Copy the S3-compatible endpoint from bucket details
#    e. Set STORAGE_PROVIDER=b2
#    f. Set B2_BUCKET_NAME, B2_KEY_ID, B2_APPLICATION_KEY, B2_ENDPOINT
#
# 4. AWS S3 (Not yet available):
#    - Coming soon
#
# 5. Azure Blob (Not yet available):
#    - Coming soon
#
# ========================================
# Switching Providers
# ========================================
#
# Development:  STORAGE_PROVIDER=local
# Production:   STORAGE_PROVIDER=b2  (recommended, lowest cost)
#               STORAGE_PROVIDER=gcs (legacy, kept for existing files)
#
# No code changes needed!
# Just update environment variable and restart server.
#
# ========================================
