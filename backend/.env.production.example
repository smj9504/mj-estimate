# Production Environment Settings
# Copy this file to .env.production and fill in your actual values

ENVIRONMENT=production
DEBUG=false
# IMPORTANT: Must be set to true in production to disable dev-only features
IS_PRODUCTION=true

# ========== Database Settings ==========
# NeonDB PostgreSQL Connection
DATABASE_TYPE=postgresql
USE_SQLITE=false
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
# Auto-create tables on startup (set to false if using Alembic migrations)
DB_AUTO_INIT=true

# ========== Server Settings ==========
HOST=0.0.0.0
PORT=8000

# ========== Security ==========
# IMPORTANT: Generate a strong secret key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_RANDOM_STRING

# ========== CORS Origins ==========
# Add your frontend URL(s)
CORS_ORIGINS=["https://your-frontend.vercel.app","https://your-custom-domain.com"]

# ========== Logging ==========
LOG_LEVEL=INFO

# ========== Storage Configuration ==========
# Storage provider: local | gdrive | gcs | b2 | s3 | azure
# RECOMMENDED: Use 'b2' (Backblaze B2) for production - lowest cost, same optimizations as GCS
STORAGE_PROVIDER=b2

# Local storage settings (not recommended for production)
STORAGE_BASE_DIR=uploads

# Backblaze B2 Settings (RECOMMENDED - lowest cost)
# S3-compatible API with the same automatic optimizations as GCS
# Cost: ~$0.006/GB/month storage (vs GCS $0.020/GB/month), 10GB storage +
# 1GB/day download free tier - typically $0/month at small scale
# Features (same as GCS):
#  - Image optimization (WebP conversion, resizing, compression)
#  - File deduplication (hash-based, saves 20-30% storage)
#  - Text compression (Gzip for JSON/CSV/logs, 70-90% reduction)
B2_BUCKET_NAME=mj-estimate-storage
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
# Region-specific endpoint shown in the B2 bucket details page
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_MAKE_PUBLIC=false

# Google Cloud Storage Settings (legacy - kept for files uploaded before B2 migration)
# Service Account authentication with automatic optimizations
# Cost: ~$2/month for 100GB (with optimizations: $0.10-0.15/month = 90-95% savings)
GCS_BUCKET_NAME=mj-estimate-storage
GCS_SERVICE_ACCOUNT_FILE=/etc/secrets/service-account-key.json
GCS_MAKE_PUBLIC=false

# Note: For Render deployment, upload service-account-key.json as a secret file
# Path will be: /etc/secrets/service-account-key.json

# Google Drive settings (separate from GCS - used for CompanyCam photo export only)
GDRIVE_SERVICE_ACCOUNT_FILE=/etc/secrets/service-account-key.json
GDRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id_here

# ========== Frontend URL ==========
# Your deployed frontend URL (for generating links in notifications)
FRONTEND_URL=https://your-frontend.vercel.app

# ========== External Integrations ==========
# Enable/Disable all integrations
ENABLE_INTEGRATIONS=true

# ========== CompanyCam Integration ==========
COMPANYCAM_API_KEY=your_companycam_api_key_here
COMPANYCAM_WEBHOOK_TOKEN=your_companycam_webhook_token_here

# ========== MagicPlan Integration ==========
MAGICPLAN_API_KEY=your_magicplan_api_key_here
MAGICPLAN_CUSTOMER_ID=your_magicplan_customer_id_here

# ========== AccuLynx Integration ==========
# Self-contained/removable module - see backend/app/domains/integrations/acculynx/
ENABLE_ACCULYNX=false
ACCULYNX_API_KEY=your_acculynx_api_key_here
# Default/fallback folder (AccuLynx's own catch-all folder is named "Other")
ACCULYNX_DOCUMENT_FOLDER_ID=your_acculynx_default_folder_id_here
# Optional per-document-type folder overrides - leave blank to always use the default above
ACCULYNX_DOCUMENT_FOLDER_ID_INVOICE=your_acculynx_invoice_folder_id_here
ACCULYNX_DOCUMENT_FOLDER_ID_WATER_MITIGATION=your_acculynx_water_mitigation_folder_id_here

# ========== Slack Integration ==========
# Incoming Webhooks (for sending messages)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#water-mitigation

# OAuth Tokens (for advanced features - optional)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# ========== Google Sheets Integration ==========
# Google API Key (from Google Cloud Console)
GOOGLE_API_KEY=your_google_api_key_here

# Google Sheets Configuration
GOOGLE_SHEETS_WATER_MITIGATION_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_WATER_MITIGATION_SHEET_NAME=Sheet1

# Additional sheets (optional)
# GOOGLE_SHEETS_WORK_ORDER_ID=
# GOOGLE_SHEETS_WORK_ORDER_SHEET_NAME=Sheet1
# GOOGLE_SHEETS_INVOICE_ID=
# GOOGLE_SHEETS_INVOICE_SHEET_NAME=Sheet1

# Multiple sheet tabs support (comma-separated), overrides SHEET_NAME above if set
# GOOGLE_SHEETS_WATER_MITIGATION_SHEET_NAMES=Angel,Vanessa

# ========== Email Settings ==========
# Email Feature Toggle (MUST be true in production for adjuster email sending)
EMAIL_ENABLED=true

# SMTP Configuration (Resend - scopit.work domain verified for SPF/DKIM)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM_EMAIL=documents@scopit.work
SMTP_FROM_NAME=Scopit

# ========== Email Ingestion ==========
ENABLE_EMAIL_INGESTION=true
# Fernet key for encrypting stored mailbox passwords (generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Falls back to SECRET_KEY if unset.
# EMAIL_ENCRYPTION_KEY=your-fernet-key

# ========== Redis Cache (Optional) ==========
REDIS_URL=your-redis-url-here

# ========== Google OAuth 2.0 (user-level Google Drive access) ==========
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://your-frontend.vercel.app/oauth/google/callback

# ========== Material Detection ==========
ENABLE_MATERIAL_DETECTION=true

# Roboflow API (for material detection)
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_WORKSPACE=your-workspace
ROBOFLOW_MODEL_ID=construction-materials
ROBOFLOW_MODEL_VERSION=1
CUSTOM_VIT_MODEL_NAME=google/vit-base-patch16-224

# Ensemble Settings
ENSEMBLE_STRATEGY=voting
ENSEMBLE_AGGREGATION=weighted_mean
ENSEMBLE_MIN_PROVIDERS=2

MATERIAL_DETECTION_CONFIDENCE_THRESHOLD=0.70
MATERIAL_DETECTION_MAX_IMAGES_PER_JOB=50

# ========== AI Services ==========
# OpenAI API Key (for GPT-4 Vision auto-labeling)
OPENAI_API_KEY=your-openai-api-key
PHOTO_ANALYSIS_CACHE_ENABLED=true
PHOTO_ANALYSIS_CACHE_TTL_DAYS=30
PHOTO_ANALYSIS_MODEL=gpt-4o

# Gemini Vision API (for photo auto-categorization)
ENABLE_AI_PHOTO_CLASSIFICATION=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ========== Xactimate Helper Tool ==========
ANTHROPIC_API_KEY=your-anthropic-api-key
# XACT_VISION_MODEL=claude-haiku-4-5-20241022
# XACT_MATCHING_MODEL=claude-sonnet-4-6-20250514
# XACT_EMBEDDING_MODEL=text-embedding-3-small
# XACT_SIMILARITY_THRESHOLD_EXACT=0.92
# XACT_SIMILARITY_THRESHOLD_HINT=0.85
# XACT_CORRECTION_AUTO_APPLY_THRESHOLD=3
# XACT_CANDIDATE_ITEM_LIMIT=8

# ========== Notes ==========
# 1. Never commit .env.production to Git
# 2. Set these values in your hosting platform (Render, Railway, etc.)
# 3. Use strong random strings for SECRET_KEY
# 4. Enable HTTPS/SSL for database connections
# 5. Verify CORS_ORIGINS matches your frontend domain
