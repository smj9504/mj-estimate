# Backend Environment Variables Example
# Copy this file to .env.development or .env.production and fill in your values

# ========== Environment Settings ==========
ENVIRONMENT=development
DEBUG=false
# Set to true ONLY in production to disable dev-only features (mock auth, etc.)
IS_PRODUCTION=false

# ========== Database Settings ==========
# Database provider: postgresql | sqlite
DATABASE_TYPE=postgresql
USE_SQLITE=false

# PostgreSQL Connection (Docker or NeonDB)
# Docker: postgresql://mjestimate:dev_password_2024@localhost:5433/mjestimate_dev
# NeonDB: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://mjestimate:dev_password_2024@localhost:5433/mjestimate_dev

# Connection pool tuning (optional, defaults shown below work for Render/NeonDB free tier)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=3600
# Auto-create tables on startup (set to false if using Alembic migrations)
# DB_AUTO_INIT=true

# Supabase (legacy alternative to DATABASE_URL - only used if DATABASE_TYPE=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# ========== Server Settings ==========
HOST=0.0.0.0
PORT=8000

# ========== Security ==========
SECRET_KEY=your-secret-key-here-change-in-production

# ========== CORS Origins ==========
# JSON array format for pydantic-settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# ========== Logging ==========
LOG_LEVEL=DEBUG

# ========== Storage Configuration ==========
# Storage provider: local | gdrive | gcs | s3 | azure
# Development: Use 'local' for simplicity
# Production: Use 'gdrive' (30GB free) or 'gcs' for reliability
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=uploads

# Google Cloud Storage Settings (optional)
# Cost: ~$2/month for 100GB
GCS_BUCKET_NAME=your-bucket-name
GCS_SERVICE_ACCOUNT_FILE=./secrets/service-account-key.json
GCS_MAKE_PUBLIC=false

# Google Drive Settings (for CompanyCam photo export)
GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/service-account-key.json
GDRIVE_ROOT_FOLDER_ID=your-folder-id

# Google OAuth 2.0 Settings (for user-level Google Drive access)
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# ========== Redis Cache (Optional) ==========
# For Upstash or local Redis
REDIS_URL=redis://localhost:6379

# ========== External Integrations ==========
# Toggle all integrations on/off
ENABLE_INTEGRATIONS=true

# CompanyCam Integration
COMPANYCAM_API_KEY=your-companycam-api-key
COMPANYCAM_WEBHOOK_TOKEN=your-webhook-token

# MagicPlan Integration
MAGICPLAN_API_KEY=your-magicplan-api-key
MAGICPLAN_CUSTOMER_ID=your-magicplan-customer-id

# AccuLynx Integration (self-contained/removable - see backend/app/domains/integrations/acculynx/)
ENABLE_ACCULYNX=false
ACCULYNX_API_KEY=your-acculynx-api-key
# Default/fallback folder (AccuLynx's own catch-all folder is named "Other")
ACCULYNX_DOCUMENT_FOLDER_ID=your-acculynx-default-folder-id
# Optional per-document-type folder overrides - leave blank to always use the default above
ACCULYNX_DOCUMENT_FOLDER_ID_INVOICE=your-acculynx-invoice-folder-id
ACCULYNX_DOCUMENT_FOLDER_ID_WATER_MITIGATION=your-acculynx-water-mitigation-folder-id

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_CHANNEL=#water-mitigation
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Frontend URL (for generating links in notifications)
FRONTEND_URL=http://localhost:3000

# ========== Email Settings ==========
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=MJ Estimate

# ========== Google Sheets Integration ==========
# Google API Key (from Google Cloud Console)
GOOGLE_API_KEY=your-google-api-key

# Water Mitigation Google Sheet
GOOGLE_SHEETS_WATER_MITIGATION_ID=your-spreadsheet-id
# Single sheet tab name (fallback)
GOOGLE_SHEETS_WATER_MITIGATION_SHEET_NAME=Sheet1
# Multiple sheet tabs support (comma-separated)
# Use this to sync multiple sheets, e.g., for multiple team members
GOOGLE_SHEETS_WATER_MITIGATION_SHEET_NAMES=Angel,Vanessa

# Work Order Google Sheet (Future)
# GOOGLE_SHEETS_WORK_ORDER_ID=
# GOOGLE_SHEETS_WORK_ORDER_SHEET_NAME=Sheet1

# Invoice Google Sheet (Future)
# GOOGLE_SHEETS_INVOICE_ID=
# GOOGLE_SHEETS_INVOICE_SHEET_NAME=Sheet1

# ========== Material Detection ==========
ENABLE_MATERIAL_DETECTION=true

# Roboflow API (for material detection)
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_WORKSPACE=your-workspace
ROBOFLOW_MODEL_ID=construction-materials
ROBOFLOW_MODEL_VERSION=1

# Custom ViT Model (Hugging Face Transformers)
CUSTOM_VIT_MODEL_NAME=google/vit-base-patch16-224
# CUSTOM_VIT_MODEL_PATH=./models/construction-materials-vit

# Ensemble Settings
ENSEMBLE_STRATEGY=voting
ENSEMBLE_AGGREGATION=weighted_mean
ENSEMBLE_MIN_PROVIDERS=2

# Material Detection Settings
MATERIAL_DETECTION_CONFIDENCE_THRESHOLD=0.70
MATERIAL_DETECTION_MAX_IMAGES_PER_JOB=50

# ========== AI Services ==========
# OpenAI API Key (for GPT-4 Vision auto-labeling)
OPENAI_API_KEY=your-openai-api-key
PHOTO_ANALYSIS_CACHE_ENABLED=true
PHOTO_ANALYSIS_CACHE_TTL_DAYS=30
PHOTO_ANALYSIS_MODEL=gpt-4o

# Gemini Vision API (for photo auto-categorization)
ENABLE_AI_PHOTO_CLASSIFICATION=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ========== Xactimate Helper Tool ==========
# Used for line-item vision matching (Claude) - see backend/app/domains/xactimate/
ANTHROPIC_API_KEY=your-anthropic-api-key
# XACT_VISION_MODEL=claude-haiku-4-5-20241022
# XACT_MATCHING_MODEL=claude-sonnet-4-6-20250514
# XACT_EMBEDDING_MODEL=text-embedding-3-small
# XACT_SIMILARITY_THRESHOLD_EXACT=0.92
# XACT_SIMILARITY_THRESHOLD_HINT=0.85
# XACT_CORRECTION_AUTO_APPLY_THRESHOLD=3
# XACT_CANDIDATE_ITEM_LIMIT=8

# ========== Email Ingestion ==========
ENABLE_EMAIL_INGESTION=true
# Fernet key for encrypting stored mailbox passwords (generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Falls back to SECRET_KEY if unset.
# EMAIL_ENCRYPTION_KEY=your-fernet-key
